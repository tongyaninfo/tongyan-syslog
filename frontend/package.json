{
  "name": "tongyan-syslog-console",
  "version": "0.1.0",
  "private": true,
  "description": "Tongyan Syslog management console",
  "scripts": {
    "setup": "max setup",
    "dev": "max dev --host 127.0.0.1 --port 8018",
    "build": "max build",
    "build:backend": "npm run build && node scripts/copy-to-backend.mjs",
    "lint": "biome check . && tsc --noEmit",
    "test": "vitest run",
    "preview:synthetic": "node scripts/preview-synthetic.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@ant-design/pro-components": "3.1.14-2",
    "@microsoft/signalr": "10.0.11",
    "antd": "6.6.0",
    "dayjs": "1.11.21",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@ant-design/cli": "6.6.0",
    "@biomejs/biome": "2.5.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@umijs/max": "4.7.3",
    "happy-dom": "20.11.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "browserslist": [
    "defaults"
  ]
}
